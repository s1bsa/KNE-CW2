    rdfs:label "registration_field_annviii_a_11"@en ;
    :hasAnnexReference :Annex_VIII ;
    :hasComponentOf :RegistrationRecord_Annex_VIII ;
    :hasSummary "A copy of the EU declaration of conformity referred to in Article 47"^^xsd:string .

