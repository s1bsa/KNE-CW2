:art56_monitoring_evaluation_and_assessment_of_codes a :GPAIObligation ;
    rdfs:label "art56_monitoring_evaluation_and_assessment_of_codes"@en ;
    :hasArticleReference :Article_56 ;
    :hasSummary "The AI Office and the Board shall regularly monitor and evaluate the achievement of the codes of practice objectives and their contribution to the proper application of this Regulation, including assessment of whether the codes cover the obligations in Articles 53 and 55, publishing adequacy assessments."^^xsd:string .

:art56_objectives_commitments_key_performance_indicators a :GPAIObligation ;
    rdfs:label "art56_objectives_commitments_key_performance_indicators"@en ;
    :hasArticleReference :Article_56 ;
    :hasSummary "Codes of practice shall clearly state their specific objectives and contain commitments or measures, including key performance indicators as appropriate, to ensure achievement of those objectives while considering the needs and interests of all parties at Union level."^^xsd:string .

:art56_reporting_on_implementation_and_outcomes a :GPAIObligation ;
    rdfs:label "art56_reporting_on_implementation_and_outcomes"@en ;
    :hasArticleReference :Article_56 ;
    :hasSummary "Participants to the codes of practice shall report regularly to the AI Office on the implementation of commitments, measures taken, and their outcomes, including progress measured against key performance indicators, reflecting size and capacity differences of participants."^^xsd:string .

:art56_training_content_summary_detail a :GPAIObligation ;
    rdfs:label "art56_training_content_summary_detail"@en ;
    :hasArticleReference :Article_56 ;
    :hasSummary "Codes of practice should ensure an adequate level of detail for the summary about the content used for training the general-purpose AI models."^^xsd:string .

:art56_updating_information_art53 a :GPAIObligation ;
    rdfs:label "art56_updating_information_art53"@en ;
    :hasArticleReference :Article_56 ;
    :hasSummary "Codes of practice should ensure that the information referred to in Article 53(1), points (a) and (b), is kept up to date considering market and technological developments."^^xsd:string .

