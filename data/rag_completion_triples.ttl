    rdfs:label "registration_field_annviii_a_12"@en ;
    :hasAnnexReference :Annex_VIII ;
    :hasComponentOf :RegistrationRecord_Annex_VIII ;
    :hasSummary "Electronic instructions for use; this information shall not be provided for high-risk AI systems in the areas of law enforcement or migration, asylum and border control management referred to in Annex III, points 1, 6 and 7"^^xsd:string .

