    rdfs:label "registration_field_annviii_a_7"@en ;
    :hasAnnexReference :Annex_VIII ;
    :hasComponentOf :RegistrationRecord_Annex_VIII ;
    :hasSummary "The status of the AI system (on the market, or in service; no longer placed on the market/in service, recalled)"^^xsd:string .

