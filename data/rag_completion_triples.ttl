    rdfs:label "registration_field_annviii_a_10"@en ;
    :hasAnnexReference :Annex_VIII ;
    :hasComponentOf :RegistrationRecord_Annex_VIII ;
    :hasSummary "Any Member States in which the AI system has been placed on the market, put into service or made available in the Union"^^xsd:string .

