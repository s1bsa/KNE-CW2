    rdfs:label "registration_field_annviii_a_13"@en ;
    :hasAnnexReference :Annex_VIII ;
    :hasComponentOf :RegistrationRecord_Annex_VIII ;
    :hasSummary "A URL for additional information (optional)"^^xsd:string .

