    :hasAnnexReference :Annex_VIII ;
    :hasComponentOf :RegistrationRecord_Annex_VIII ;
    :hasSummary "Where submission of information is carried out by another person on behalf of the provider, the name, address and contact details of that person"^^xsd:string .

