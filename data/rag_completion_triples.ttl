:deployer_human_oversight_measures_art14_3b :requiresControl :risk_control_art14_4_a,
        :risk_control_art14_4_b .

:enforcement_power_art101 :hasFine 15000000.0 ;
    :hasMaximumFineRatio 0.03 .

:enforcement_power_art37_4 :hasMaximumFineRatio 0.03 .

