    :hasMaximumFineRatio 0.03 .

:enforcement_power_art80_7 :hasFine 15000000.0 ;
    :hasMaximumFineRatio 0.03 .

:enforcement_power_art83 :hasFine 15000000.0 ;
    :hasMaximumFineRatio 0.03 .

:enforcement_power_art83_restriction_prohibition :hasFine 35000000.0 ;
    :hasMaximumFineRatio 0.03 .

:human_oversight_aim_risk_prevention_art14_2 :requiresControl :risk_control_art14_4_a,
        :risk_control_art14_4_b .

:monitor_operation_and_incident_reporting_deployers_art26_5 :hasDeadline "P0D"^^xsd:duration .

:provider_human_oversight_measures_art14_3a :hasDeadline "P0D"^^xsd:duration .

:AreaOfApplication_biometrics a :AreaOfApplication ;
    rdfs:label "Biometrics"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "AI systems intended for remote biometric identification, biometric categorisation based on sensitive or protected attributes, and emotion recognition, insofar as their use is permitted by law."^^xsd:string .

:AreaOfApplication_critical_infrastructure a :AreaOfApplication ;
    rdfs:label "Critical infrastructure"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "AI systems used as safety components in the management and operation of critical digital infrastructure, road traffic, or in the supply of water, gas, heating or electricity."^^xsd:string .

:AreaOfApplication_education a :AreaOfApplication ;
    rdfs:label "Education and vocational training"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "AI systems used to determine access or admission to educational institutions, evaluate learning outcomes, assess appropriate education levels, and monitor student behavior during tests."^^xsd:string .

:AreaOfApplication_employment a :AreaOfApplication ;
    rdfs:label "Employment, workers management and access to self-employment"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "AI systems intended for recruitment or selection processes, managing work-related decisions such as promotions or terminations, task allocation based on personal traits, and monitoring and evaluating worker performance and behavior."^^xsd:string .

:AreaOfApplication_essential_services a :AreaOfApplication ;
    rdfs:label "Access to and enjoyment of essential private and public services and benefits"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "AI systems used by public authorities to evaluate eligibility for essential public assistance, assess creditworthiness, perform risk assessment and pricing in life and health insurance, and to manage emergency call classifications and first response services."^^xsd:string .

:AreaOfApplication_justice a :AreaOfApplication ;
    rdfs:label "Administration of justice and democratic processes"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "AI systems used by judicial authorities to assist in researching and interpreting facts and laws for judicial decisions and alternative dispute resolution, and AI systems intended to influence election or referendum outcomes and voting behavior, excluding administrative campaign tools."^^xsd:string .

:AreaOfApplication_law_enforcement a :AreaOfApplication ;
    rdfs:label "Law enforcement"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "AI systems used by or on behalf of law enforcement authorities to assess victim risk, act as polygraphs or similar tools, evaluate evidence reliability, assess offending risk, and profile individuals in criminal investigations as permitted by law."^^xsd:string .

:AreaOfApplication_migration a :AreaOfApplication ;
    rdfs:label "Migration, asylum and border control management"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "AI systems used by competent public authorities or EU agencies for polygraph-like assessments, risk evaluation related to migration or health, asylum and visa application assessments, and identification in migration and border control contexts, as permitted by law."^^xsd:string .

:documentation_component_anniv_2_a a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_2_a"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "The methods and steps performed for the development of the AI system, including the use and integration or modification of pre-trained systems or third-party tools by the provider."^^xsd:string .

:documentation_component_anniv_2_b a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_2_b"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "The design specifications of the AI system, covering its general logic, key design choices and rationale including assumptions about users, classification choices, optimization goals, expected outputs and quality, and any trade-offs made to ensure compliance with applicable requirements."^^xsd:string .

:documentation_component_anniv_2_c a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_2_c"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "The system architecture description explaining software component integration, dependencies, and the computational resources used for development, training, testing, and validation of the AI system."^^xsd:string .

:documentation_component_anniv_2_d a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_2_d"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "Data requirements including datasheets describing training methodologies, data sets characteristics, provenance, selection, labelling procedures, and data cleaning methods relevant to the AI system."^^xsd:string .

:documentation_component_anniv_2_e a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_2_e"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "Assessment of human oversight measures in accordance with Article 14, and technical measures to facilitate deployers’ interpretation of AI system outputs, as required by Article 13(3)(d)."^^xsd:string .

:documentation_component_anniv_2_f a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_2_f"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "Detailed description of pre-determined changes to the AI system and performance, including technical solutions adopted to ensure continuous compliance with relevant requirements set out in Chapter III, Section 2."^^xsd:string .

:documentation_component_anniv_2_g a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_2_g"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "Validation and testing procedures including information about validation/testing data, metrics for accuracy, robustness, compliance, and discrimination impacts, along with test logs and signed reports, including for pre-determined changes."^^xsd:string .

:documentation_component_anniv_2_h a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_2_h"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "Cybersecurity measures put in place for the AI system."^^xsd:string .

:documentation_component_anniv_3 a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_3"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "Detailed information about the monitoring, functioning and control of the AI system, including capabilities and limitations in performance, foreseeable unintended outcomes and risks to health, safety, fundamental rights and discrimination, and human oversight measures, with specifications on input data as appropriate."^^xsd:string .

:documentation_component_anniv_4 a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_4"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "Description of the appropriateness of the performance metrics used for the specific AI system."^^xsd:string .

:documentation_component_anniv_5 a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_5"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "Detailed description of the risk management system in accordance with Article 9 governing the AI system."^^xsd:string .

:documentation_component_anniv_6 a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_6"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "Description of relevant changes made by the provider to the AI system throughout its lifecycle."^^xsd:string .

:documentation_component_anniv_7 a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_7"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "A list of harmonised standards applied in full or in part, with references published in the Official Journal of the European Union; or, if none applied, a detailed description of solutions adopted to meet requirements including other relevant standards and technical specifications."^^xsd:string .

:documentation_component_anniv_8 a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_8"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "A copy of the EU declaration of conformity referred to in Article 47."^^xsd:string .

:documentation_component_anniv_9 a :DocumentationComponent ;
    rdfs:label "documentation_component_anniv_9"@en ;
    :hasAnnexReference :Annex_IV ;
    :hasComponentOf :TechnicalDocumentation_Annex_IV ;
    :hasSummary "Detailed description of the system for evaluating AI system performance in the post-market phase pursuant to Article 72, including the post-market monitoring plan referred to in Article 72(3)."^^xsd:string .

:registration_field_annviii_a_1 a :RegistrationField ;
    rdfs:label "registration_field_annviii_a_1"@en ;
    :hasAnnexReference :Annex_VIII ;
    :hasComponentOf :RegistrationRecord_Annex_VIII ;
    :hasSummary "The name, address and contact details of the provider"^^xsd:string .

