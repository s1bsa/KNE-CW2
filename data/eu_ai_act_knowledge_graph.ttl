:Annex_VI a :Annex ;
    rdfs:label "Annex VI — Conformity assessment procedure based on internal control"@en ;
    :hasSourceURL "https://artificialintelligenceact.eu/annex/6/"^^xsd:string ;
    :hasSummary "Article 43 of the AI Act provides some scenarios in which a \"conformity assessment procedure based on internal control\" might be required. This Annex explains what that process should be."^^xsd:string .

:AreaOfApplication_biometrics a :AreaOfApplication ;
    rdfs:label "Biometrics"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "Remote biometric identification, biometric categorisation by sensitive attributes, and emotion recognition systems."^^xsd:string .

:AreaOfApplication_critical_infrastructure a :AreaOfApplication ;
    rdfs:label "Critical infrastructure"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "Safety components in the management and operation of critical digital infrastructure, road traffic, and the supply of water, gas, heating and electricity."^^xsd:string .

:AreaOfApplication_education a :AreaOfApplication ;
    rdfs:label "Education and vocational training"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "AI used to determine access, admission, evaluation of learning outcomes, assessing appropriate level of education, or monitoring prohibited behaviour during tests."^^xsd:string .

:AreaOfApplication_employment a :AreaOfApplication ;
    rdfs:label "Employment, workers management and access to self-employment"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "Recruitment, selection, decisions affecting terms of work, promotion, termination, task allocation based on individual behaviour or traits, and monitoring/evaluation of performance."^^xsd:string .

:AreaOfApplication_essential_services a :AreaOfApplication ;
    rdfs:label "Access to and enjoyment of essential private and public services"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "Eligibility for public assistance benefits, creditworthiness evaluation, risk assessment and pricing in life and health insurance, and emergency call dispatch and triage."^^xsd:string .

:AreaOfApplication_justice a :AreaOfApplication ;
    rdfs:label "Administration of justice and democratic processes"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "AI assisting judicial authorities in researching and interpreting facts and the law, and AI intended to influence the outcome of an election or voting behaviour."^^xsd:string .

:AreaOfApplication_law_enforcement a :AreaOfApplication ;
    rdfs:label "Law enforcement"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "Risk assessment of natural persons, polygraphs, evidence reliability assessment, profiling, and crime analytics."^^xsd:string .

:AreaOfApplication_migration a :AreaOfApplication ;
    rdfs:label "Migration, asylum and border control management"@en ;
    :hasAnnexReference :Annex_III ;
    :hasSummary "Polygraphs, risk assessments, examination of applications for asylum/visa/residence, and detection/recognition of natural persons at borders."^^xsd:string .

:Article_18 a :Article ;
    rdfs:label "Article 18 — Documentation keeping"@en ;
    :hasParagraphReference :Paragraph_Article_18_1,
        :Paragraph_Article_18_1_a,
        :Paragraph_Article_18_1_b,
        :Paragraph_Article_18_1_c,
        :Paragraph_Article_18_1_d,
        :Paragraph_Article_18_1_e,
        :Paragraph_Article_18_2,
        :Paragraph_Article_18_3 ;
    :hasSourceURL "data/unstructured/eu_ai_act_content.html"^^xsd:string,
        "https://artificialintelligenceact.eu/article/18/"^^xsd:string ;
    :hasSummary "This article states that providers of high-risk AI systems must keep certain documents for 10 years after the system is released. These documents include technical documentation, quality management system documentation, approved changes, decisions from notified bodies, and the EU declaration of conformity. If the provider goes bankrupt or stops its activities before the 10 years are up, each EU member state will decide how to keep these documents available. Financial institutions that are providers must keep the technical documentation as part of their documentation under Union financial services law."^^xsd:string .

:Article_3 a :Article ;
    rdfs:label "Article 3 — Definitions"@en ;
    :cites :Legislation_32012R1025,
        :Legislation_32016R0679,
        :Legislation_32018R1725,
        :Legislation_32019R1020 ;
    :hasParagraphReference :Paragraph_Article_3,
        :Paragraph_Article_3_1,
        :Paragraph_Article_3_10,
