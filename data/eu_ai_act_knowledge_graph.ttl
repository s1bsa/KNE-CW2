:authorisation_and_use_restrictions_post_remote_biometric_deployers_art26_10 a :ProceduralCondition ;
    rdfs:label "authorisation_and_use_restrictions_post_remote_biometric_deployers_art26_10"@en ;
    rdfs:comment "cq_target: CQ6"@en,
        "evidence: the deployer of a high-risk AI system for post-remote biometric identification shall request an authorisation, ex ante, or without undue delay ... except when used for initial identification"@en ;
    :hasArticleReference :Article_26 ;
    :hasParagraphReference :Paragraph_Article_26_10 ;
    :hasSummary "Deployers must obtain ex ante or prompt authorisation by competent authorities to use high-risk AI systems for post-remote biometric identification in targeted criminal investigations, limited to what is strictly necessary."^^xsd:string .

:ce_marking_art47 a :CEMarking ;
    rdfs:label "ce_marking_art47"@en ;
    rdfs:comment "cq_target: LLM1"@en,
        "cq_target: LLM3"@en,
        "evidence: The provider shall draw up a written machine readable, physical or electronically signed EU declaration of conformity for each high-risk AI system, and keep it at the disposal ... for 10 years after.."@en ;
    :hasArticleReference :Article_47 ;
    :hasParagraphReference :Paragraph_Article_47_1 ;
    :hasSummary "The provider shall draw up a written machine readable, physical or electronically signed EU declaration of conformity for each high-risk AI system and keep it for 10 years after market placement or service."^^xsd:string .

:ce_marking_art48_1 a :CEMarking ;
    rdfs:label "ce_marking_art48_1"@en ;
    rdfs:comment "evidence: The CE marking shall be subject to the general principles set out in Article 30 of Regulation (EC) No 765/2008."@en ;
    :hasArticleReference :Article_30,
        :Article_48 ;
    :hasParagraphReference :Paragraph_Article_48_1 ;
    :hasSummary "The CE marking shall follow the general principles set out in Article 30 of Regulation (EC) No 765/2008."^^xsd:string .

:ce_marking_art48_2 a :CEMarking ;
    rdfs:label "ce_marking_art48_2"@en ;
    rdfs:comment "evidence: a digital CE marking shall be used, only if it can easily be accessed via the interface from which that system is accessed or via an easily accessible machine-readable code or other electronic means."@en ;
    :hasArticleReference :Article_48 ;
    :hasParagraphReference :Paragraph_Article_48_2 ;
    :hasSummary "For high-risk AI systems provided digitally, the CE marking shall be a digital mark accessible via the system interface or an easily accessible electronic means."^^xsd:string .

:ce_marking_art48_3 a :CEMarking ;
    rdfs:label "ce_marking_art48_3"@en ;
    rdfs:comment "evidence: The CE marking shall be affixed visibly, legibly and indelibly for high-risk AI systems. Where that is not possible...it shall be affixed to the packaging or...documentation."@en ;
    :hasArticleReference :Article_48 ;
    :hasParagraphReference :Paragraph_Article_48_3 ;
    :hasSummary "The CE marking for high-risk AI systems shall be affixed visibly, legibly and indelibly; if not possible, it shall be affixed to the packaging or accompanying documentation."^^xsd:string .

:ce_marking_art48_4 a :CEMarking ;
    rdfs:label "ce_marking_art48_4"@en ;
    rdfs:comment "evidence: the CE marking shall be followed by the identification number of the notified body...also indicated in any promotional material which mentions that the high-risk AI system fulfils the requirements for"@en ;
    :hasArticleReference :Article_48 ;
    :hasParagraphReference :Paragraph_Article_48_4 ;
    :hasSummary "The CE marking shall be followed by the notified body's identification number, affixed by the body or under its instruction, and also shown in promotional material mentioning CE compliance."^^xsd:string .

:ce_marking_art48_5 a :CEMarking ;
    rdfs:label "ce_marking_art48_5"@en ;
    rdfs:comment "evidence: Where high-risk AI systems are subject to other Union law which also provides for the affixing of the CE marking, the CE marking shall indicate that the high-risk AI system also fulfil the requirement"@en ;
    :hasArticleReference :Article_48 ;
    :hasParagraphReference :Paragraph_Article_48_5 ;
    :hasSummary "When high-risk AI systems are subject to other Union law requiring CE marking, the CE marking shall indicate compliance with those other laws as well."^^xsd:string .

:confidentiality_condition_art70_5 a :ProceduralCondition ;
    rdfs:label "confidentiality_condition_art70_5"@en ;
    rdfs:comment "evidence: national competent authorities shall act in accordance with the confidentiality obligations set out in Article 78"@en ;
    :hasArticleReference :Article_70,
        :Article_78 ;
    :hasParagraphReference :Paragraph_Article_70_5 ;
    :hasSummary "National competent authorities shall act in accordance with confidentiality obligations set out in Article 78 when performing their tasks."^^xsd:string .

:data_geographical_context_condition_art10_4 a :NecessityCondition ;
    rdfs:label "data_geographical_context_condition_art10_4"@en ;
    rdfs:comment "evidence: Data sets shall take into account...the characteristics or elements that are particular to the specific geographical, contextual, behavioural or functional setting."@en ;
    :hasArticleReference :Article_10 ;
    :hasParagraphReference :Paragraph_Article_10_4 ;
    :hasSummary "Data sets must take into account characteristics particular to the specific geographical, contextual, behavioural or functional setting where the high-risk AI system is intended to be used, to the extent required by the intended purpose."^^xsd:string .

:natural_person_subject_art86 a dpv:NaturalPerson ;
    rdfs:label "natural_person_subject_art86"@en ;
    rdfs:comment "evidence: Any affected person subject to a decision... and the main elements of the decision taken"@en ;
    :hasArticleReference :Article_86 ;
    :hasParagraphReference :Paragraph_Article_86_1 ;
    :hasSummary "Any affected person subject to a decision based on the output from a high-risk AI system that produces legal effects or significantly affects them with adverse impact has the right to obtain clear explanations from the deployer."^^xsd:string .

:necessity_condition_art46_1 a :NecessityCondition ;
    rdfs:label "necessity_condition_art46_1"@en ;
    rdfs:comment "cq_target: LLM9"@en,
        "evidence: for exceptional reasons of public security or the protection of life and health of persons, environmental protection or the protection of key industrial and infrastructural assets"@en ;
    :hasArticleReference :Article_46 ;
    :hasParagraphReference :Paragraph_Article_46_1 ;
    :hasSummary "Authorization for derogation from conformity assessment is limited to exceptional reasons of public security, protection of life and health, environmental protection or protection of key industrial and infrastructural assets."^^xsd:string .

:necessity_condition_art46_2 a :NecessityCondition ;
    rdfs:label "necessity_condition_art46_2"@en ;
    rdfs:comment "cq_target: LLM9"@en,
        "evidence: in a duly justified situation of urgency for exceptional reasons of public security or in the case of specific, substantial and imminent threat to the life or physical safety of natural persons, law-e"@en ;
    :hasArticleReference :Article_46 ;
    :hasParagraphReference :Paragraph_Article_46_2 ;
    :hasSummary "Law-enforcement or civil protection authorities may put a specific high-risk AI system into service without authorization in a justified urgent situation of public security or imminent threat to life or physical safety of natural persons."^^xsd:string .

:necessity_condition_art46_3 a :NecessityCondition ;
    rdfs:label "necessity_condition_art46_3"@en ;
    rdfs:comment "cq_target: LLM9"@en,
        "evidence: The authorisation ... shall be issued only if ... the high-risk AI system complies with the requirements of Section 2 ... not cover sensitive operational data in relation to law-enforcement"@en ;
    :hasArticleReference :Article_46 ;
    :hasParagraphReference :Paragraph_Article_46_3 ;
    :hasSummary "Authorization is issued only if the market surveillance authority concludes compliance with Section 2 requirements, excluding sensitive law-enforcement operational data."^^xsd:string .

:necessity_condition_art46_7 a :NecessityCondition ;
    rdfs:label "necessity_condition_art46_7"@en ;
    rdfs:comment "cq_target: LLM9"@en,
        "evidence: only the derogations from the conformity assessment established in that Union harmonisation legislation shall apply"@en ;
    :hasArticleReference :Article_46 ;
    :hasParagraphReference :Paragraph_Article_46_7 ;
    :hasSummary "For high-risk AI systems covered by Union harmonisation legislation, only derogations established in that legislation apply."^^xsd:string .

:necessity_condition_importer_art23_2 a :NecessityCondition ;
    rdfs:label "necessity_condition_importer_art23_2"@en ;
    rdfs:comment "cq_target: CQ2"@en,
        "cq_target: LLM9"@en,
        "evidence: shall not place the system on the market until it has been brought into conformity"@en ;
    :hasArticleReference :Article_23 ;
    :hasParagraphReference :Paragraph_Article_23_2 ;
    :hasSummary "If importers have reason to believe a high-risk AI system is non-conforming, falsified, or accompanied by falsified documentation, they must not place it on the market until conformity is ensured."^^xsd:string .

:procedural_condition_art46_1 a :ProceduralCondition ;
    rdfs:label "procedural_condition_art46_1"@en ;
    rdfs:comment "evidence: That authorisation shall be for a limited period while the necessary conformity assessment procedures are being carried out, taking into account the exceptional reasons justifying the derogation"@en ;
    :hasArticleReference :Article_46 ;
    :hasParagraphReference :Paragraph_Article_46_1 ;
    :hasSummary "The derogation authorization shall be for a limited period and only while the necessary conformity assessment procedures are being carried out without undue delay."^^xsd:string .

:procedural_condition_art46_2 a :ProceduralCondition ;
    rdfs:label "procedural_condition_art46_2"@en ;
    rdfs:comment "evidence: provided that such authorisation is requested during or after the use without undue delay. If the authorisation ... is refused, the use ... shall be stopped immediately and all the results ... discard"@en ;
    :hasArticleReference :Article_46 ;
    :hasParagraphReference :Paragraph_Article_46_2 ;
    :hasSummary "Authorization must be requested during or after use without undue delay, and if refused, use must stop immediately with all outputs discarded."^^xsd:string .

:procedural_condition_art46_3 a :ProceduralCondition ;
    rdfs:label "procedural_condition_art46_3"@en ;
    rdfs:comment "evidence: The market surveillance authority shall inform the Commission and the other Member States of any authorisation issued pursuant to paragraphs 1 and 2"@en ;
    :hasArticleReference :Article_46 ;
    :hasParagraphReference :Paragraph_Article_46_3 ;
    :hasSummary "The market surveillance authority must inform the Commission and other Member States of any authorization issued pursuant to paragraphs 1 and 2."^^xsd:string .

:procedural_condition_art46_4 a :ProceduralCondition ;
    rdfs:label "procedural_condition_art46_4"@en ;
    rdfs:comment "evidence: within 15 calendar days ... no objection has been raised ... that authorisation shall be deemed justified"@en ;
    :hasArticleReference :Article_46 ;
    :hasParagraphReference :Paragraph_Article_46_4 ;
    :hasSummary "Authorization is deemed justified if within 15 calendar days of notification no objection is raised by a Member State or the Commission."^^xsd:string .

:procedural_condition_art46_5 a :ProceduralCondition ;
    rdfs:label "procedural_condition_art46_5"@en ;
    rdfs:comment "evidence: objections ... or ... Commission considers the authorisation contrary ... Commission shall ... enter into consultations ... then decide"@en ;
    :hasArticleReference :Article_46 ;
    :hasParagraphReference :Paragraph_Article_46_5 ;
    :hasSummary "If objections arise or the Commission considers the authorization contrary to Union law or unfounded, it shall consult with the Member State and operators, then decide on justification."^^xsd:string .

:procedural_condition_art46_6 a :ProceduralCondition ;
    rdfs:label "procedural_condition_art46_6"@en ;
    rdfs:comment "evidence: Where the Commission considers the authorisation unjustified, it shall be withdrawn by the market surveillance authority"@en ;
    :hasArticleReference :Article_46 ;
    :hasParagraphReference :Paragraph_Article_46_6 ;
    :hasSummary "If the Commission considers the authorization unjustified, it shall be withdrawn by the market surveillance authority of the relevant Member State."^^xsd:string .

:prohibited_practice_art5_1_a a eu-aiact:ProhibitedPractice ;
    rdfs:label "Article 5(1)(a) prohibited practice"@en ;
    :hasArticleReference :Article_5 ;
    :hasParagraphReference :Paragraph_Article_5_1_a ;
    :hasSummary "(a) the placing on the market, the putting into service or the use of an AI system that deploys subliminal techniques beyond a person’s consciousness or purposefully manipulative or deceptive techniques, with the objective, or the effect of materially distorting the behaviour of a person or a group of persons by appreciably impairing their ability to make an informed decision, thereby causing them to take a decision that they would not have otherwise taken in a manner that causes or is reasonably likely to cause that person, another person or group of persons significant harm;"^^xsd:string .

:prohibited_practice_art5_1_b a eu-aiact:ProhibitedPractice ;
    rdfs:label "Article 5(1)(b) prohibited practice"@en ;
    :hasArticleReference :Article_5 ;
    :hasParagraphReference :Paragraph_Article_5_1_b ;
    :hasSummary "(b) the placing on the market, the putting into service or the use of an AI system that exploits any of the vulnerabilities of a natural person or a specific group of persons due to their age, disability or a specific social or economic situation, with the objective, or the effect, of materially distorting the behaviour of that person or a person belonging to that group in a manner that causes or is reasonably likely to cause that person or another person significant harm;"^^xsd:string .

:prohibited_practice_art5_1_c a eu-aiact:ProhibitedPractice ;
    rdfs:label "Article 5(1)(c) prohibited practice"@en ;
    :hasArticleReference :Article_5 ;
    :hasParagraphReference :Paragraph_Article_5_1_c ;
    :hasSummary "(c) the placing on the market, the putting into service or the use of AI systems for the evaluation or classification of natural persons or groups of persons over a certain period of time based on their social behaviour or known, inferred or predicted personal or personality characteristics, with the social score leading to either or both of the following:"^^xsd:string .

:prohibited_practice_art5_1_d a eu-aiact:ProhibitedPractice ;
    rdfs:label "Article 5(1)(d) prohibited practice"@en ;
    :hasArticleReference :Article_5 ;
    :hasParagraphReference :Paragraph_Article_5_1_d ;
    :hasSummary "(d) the placing on the market, the putting into service for this specific purpose, or the use of an AI system for making risk assessments of natural persons in order to assess or predict the risk of a natural person committing a criminal offence, based solely on the profiling of a natural person or on assessing their personality traits and characteristics; this prohibition shall not apply to AI systems used to support the human assessment of the involvement of a person in a criminal activity, which is already based on objective and verifiable facts directly linked to a criminal activity;"^^xsd:string .

:prohibited_practice_art5_1_e a eu-aiact:ProhibitedPractice ;
    rdfs:label "Article 5(1)(e) prohibited practice"@en ;
    :hasArticleReference :Article_5 ;
    :hasParagraphReference :Paragraph_Article_5_1_e ;
    :hasSummary "(e) the placing on the market, the putting into service for this specific purpose, or the use of AI systems that create or expand facial recognition databases through the untargeted scraping of facial images from the internet or CCTV footage;"^^xsd:string .

:prohibited_practice_art5_1_f a eu-aiact:ProhibitedPractice ;
    rdfs:label "Article 5(1)(f) prohibited practice"@en ;
    :hasArticleReference :Article_5 ;
    :hasParagraphReference :Paragraph_Article_5_1_f ;
    :hasSummary "(f) the placing on the market, the putting into service for this specific purpose, or the use of AI systems to infer emotions of a natural person in the areas of workplace and education institutions, except where the use of the AI system is intended to be put in place or into the market for medical or safety reasons;"^^xsd:string .

:prohibited_practice_art5_1_g a eu-aiact:ProhibitedPractice ;
    rdfs:label "Article 5(1)(g) prohibited practice"@en ;
    :hasArticleReference :Article_5 ;
    :hasParagraphReference :Paragraph_Article_5_1_g ;
    :hasSummary "(g) the placing on the market, the putting into service for this specific purpose, or the use of biometric categorisation systems that categorise individually natural persons based on their biometric data to deduce or infer their race, political opinions, trade union membership, religious or philosophical beliefs, sex life or sexual orientation; this prohibition does not cover any labelling or filtering of lawfully acquired biometric datasets, such as images, based on biometric data or categorizing of biometric data in the area of law enforcement;"^^xsd:string .

:prohibited_practice_art5_1_h a eu-aiact:ProhibitedPractice ;
    rdfs:label "Article 5(1)(h) prohibited practice — real-time remote biometric identification"@en ;
    :hasArticleReference :Article_5 ;
    :hasCondition :necessity_condition_realtime_remote_biometric_identification_law_enforcement_5_1_h_art5,
        :prior_authorisation_condition_realtime_remote_biometric_5_3_art5,
        :prohibited_ai_practice_biometric_categorisation_sensitive_data_5_1_g_art5,
        :prohibited_ai_practice_criminal_offense_risk_assessment_5_1_d_art5,
        :prohibited_ai_practice_emotion_inference_workplace_education_5_1_f_art5,
        :prohibited_ai_practice_exploitation_vulnerabilities_5_1_b_art5,
        :prohibited_ai_practice_social_scoring_5_1_c_art5,
        :prohibited_ai_practice_subliminal_manipulative_5_1_a_art5,
        :prohibited_ai_practice_untargeted_facial_recognition_databases_5_1_e_art5,
        :proportionality_condition_law_enforcement_realtime_remote_biometric_use_5_2_art5,
        :proportionality_condition_realtime_remote_biometric_5_3_art5 ;
    :hasParagraphReference :Paragraph_Article_5_1_h ;
    :hasSummary "(h) the use of ‘real-time’ remote biometric identification systems in publicly accessible spaces for the purposes of law enforcement, unless and in so far as such use is strictly necessary for one of the following objectives:"^^xsd:string .

:provider_authorised_representative_exemption_condition_art54_6 a :NecessityCondition ;
    rdfs:label "provider_authorised_representative_exemption_condition_art54_6"@en ;
    rdfs:comment "cq_target: CQ5"@en,
        "cq_target: LLM6"@en,
        "evidence: shall not apply to providers... free and open-source licence... unless... models present systemic risks"@en ;
    :hasArticleReference :Article_54 ;
    :hasParagraphReference :Paragraph_Article_54_6 ;
    :hasSummary "The requirement to appoint an authorised representative does not apply to providers of free and open-source general-purpose AI models unless the models present systemic risks."^^xsd:string .

:quality_management_system_proportionality_condition_art17_2 a :ProportionalityCondition ;
    rdfs:label "quality_management_system_proportionality_condition_art17_2"@en ;
    rdfs:comment "cq_target: CQ2"@en,
        "cq_target: LLM1"@en,
        "cq_target: LLM2"@en,
        "cq_target: LLM9"@en,
        "evidence: The implementation of the aspects referred to in paragraph 1 shall be proportionate to the size of the provider’s organisation"@en ;
    :hasArticleReference :Article_17 ;
    :hasParagraphReference :Paragraph_Article_17_2 ;
    :hasSummary "Implementation of quality management aspects shall be proportionate to the size of the provider's organisation but respect the required rigour and protection to ensure compliance."^^xsd:string .

:registration_obligation_high_risk_deployers_public_art49_3 a :ProceduralCondition ;
    rdfs:label "registration_obligation_high_risk_deployers_public_art49_3"@en ;
    rdfs:comment "cq_target: CQ6"@en,
        "evidence: deployers that are public authorities, Union institutions, bodies, offices or agencies or persons acting on their behalf shall register themselves, select the system and register its use in the EU dat"@en ;
    :hasArticleReference :Article_49 ;
    :hasParagraphReference :Paragraph_Article_49_3 ;
    :hasSummary "Deployers that are public authorities, Union institutions, bodies, offices, agencies or persons acting on their behalf must register themselves, select the system, and register its use in the EU database before putting into service or using a high-risk AI system listed in Annex III (except point 2 of Annex III)."^^xsd:string .

:registration_obligation_high_risk_point2_national_level_art49_5 a :ProceduralCondition ;
    rdfs:label "registration_obligation_high_risk_point2_national_level_art49_5"@en ;
    rdfs:comment "evidence: High-risk AI systems referred to in point 2 of Annex III shall be registered at national level"@en ;
    :hasArticleReference :Article_49 ;
    :hasParagraphReference :Paragraph_Article_49_5 ;
    :hasSummary "High-risk AI systems referred to in point 2 of Annex III must be registered at the national level rather than in the EU database."^^xsd:string .

:registration_obligation_high_risk_providers_art49_1 a :ProceduralCondition ;
    rdfs:label "registration_obligation_high_risk_providers_art49_1"@en ;
    rdfs:comment "cq_target: CQ2"@en,
        "evidence: provider or, where applicable, the authorised representative shall register themselves and their system in the EU database"@en ;
    :hasArticleReference :Article_49 ;
    :hasParagraphReference :Paragraph_Article_49_1 ;
    :hasSummary "Providers or authorised representatives of high-risk AI systems listed in Annex III (except point 2 of Annex III) must register themselves and their system in the EU database before placing the system on the market or putting it into service."^^xsd:string .

:registration_obligation_non_high_risk_providers_art49_2 a :ProceduralCondition ;
    rdfs:label "registration_obligation_non_high_risk_providers_art49_2"@en ;
    rdfs:comment "cq_target: CQ2"@en,
        "evidence: provider or, where applicable, the authorised representative shall register themselves and that system in the EU database"@en ;
    :hasArticleReference :Article_49 ;
    :hasParagraphReference :Paragraph_Article_49_2 ;
    :hasSummary "Providers or authorised representatives of AI systems concluded to be not high-risk must register themselves and their system in the EU database before placing the system on the market or putting it into service."^^xsd:string .

:registration_obligation_secure_non_public_section_art49_4 a :ProceduralCondition ;
    rdfs:label "registration_obligation_secure_non_public_section_art49_4"@en ;
    rdfs:comment "evidence: registration...shall be in a secure non-public section of the EU database...Only the Commission and national authorities...shall have access"@en ;
    :hasArticleReference :Article_49 ;
    :hasParagraphReference :Paragraph_Article_49_4 ;
    :hasSummary "Registrations for high-risk AI systems in law enforcement, migration, asylum and border control listed in points 1, 6, and 7 of Annex III must be in a secure non-public section of the EU database accessible only to the Commission and specified national authorities."^^xsd:string .

:special_category_data_processing_condition_art10_5 a :NecessityCondition ;
    rdfs:label "special_category_data_processing_condition_art10_5"@en ;
    rdfs:comment "cq_target: CQ2"@en,
        "cq_target: LLM9"@en,
        "evidence: Providers of such systems may exceptionally process special categories of personal data, subject to appropriate safeguards for the fundamental rights and freedoms of natural persons."@en ;
    :hasArticleReference :Article_10 ;
    :hasParagraphReference :Paragraph_Article_10_5 ;
    :hasSummary "Providers may exceptionally process special categories of personal data strictly necessary for bias detection and correction, subject to safeguards and conditions including non-effectiveness of other data, technical limitations, access controls, restricted transmission, deletion, and documentation."^^xsd:string .

